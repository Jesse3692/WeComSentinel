# Copy to .env. Generate secrets: python -m app.cli generate-keys
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PAYLOAD_KEY=
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
WORKER_ENABLED=true
# Report aggregation cache window in seconds (0 disables). Dashboard replies for the
# same viewer permissions/date range are reused; pending job counts stay live.
REPORT_CACHE_SECONDS=30
# Async SQLAlchemy pool for SQLite WAL readers; raise for heavy report concurrency.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
MEDIA_DIR=./data/media
# Development demo requires explicit enablement; never enabled in production.
DEMO_ENABLED=false
DEMO_PASSWORD=
# Internal DingTalk H5 application
DING_CORP_ID=
DING_CLIENT_ID=
DING_CLIENT_SECRET=
DING_AGENT_ID=
# 客户分析助手：留空地址使用规则查询；vLLM 地址填写到 /v1，无密钥可留空。
ASSISTANT_ENABLED=true
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=qwen35-122b-local
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=45
ASSISTANT_MAX_TOKENS=1200
# Credential ref "ACME" -> these environment variable names, or .env entries
# Optional for the diagnostic script; runtime CorpID comes from the tenant configuration.
WECOM_ACME_CORP_ID=
WECOM_ACME_SECRET=
WECOM_ACME_TOKEN=
WECOM_ACME_AES_KEY=
