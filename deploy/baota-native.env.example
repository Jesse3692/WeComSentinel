# Copy to project-root .env. See docs/宝塔非容器部署.md.
APP_ENV=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PAYLOAD_KEY=
PUBLIC_ORIGIN=https://monitor.example.com
COOKIE_SECURE=true
DEMO_ENABLED=false
DEMO_PASSWORD=
WORKER_ENABLED=true
# Resolved from the systemd WorkingDirectory (the project root).
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db
MEDIA_DIR=./data/media

DING_CORP_ID=
DING_CLIENT_ID=
DING_CLIENT_SECRET=
DING_AGENT_ID=

WECOM_ACME_CORP_ID=
WECOM_ACME_SECRET=
WECOM_ACME_TOKEN=
WECOM_ACME_AES_KEY=
