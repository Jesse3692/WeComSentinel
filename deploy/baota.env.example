# Copy to project-root .env on the server. Do not upload the local demo .env.
# Generate both keys using the command in docs/宝塔部署.md.
APP_ENV=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
PAYLOAD_KEY=
PUBLIC_ORIGIN=https://monitor.example.com
COOKIE_SECURE=true
DEMO_ENABLED=false
DEMO_PASSWORD=
WORKER_ENABLED=true
# compose.baota.yaml also sets these container paths explicitly.
DATABASE_URL=sqlite+aiosqlite:////app/data/monitor.db
MEDIA_DIR=/app/data/media

# DingTalk internal H5 application
DING_CORP_ID=
DING_CLIENT_ID=
DING_CLIENT_SECRET=
DING_AGENT_ID=

# Create a tenant with credential_ref ACME in the administration page.
# Runtime CorpID comes from the tenant; this optional value is for diagnostics.
WECOM_ACME_CORP_ID=
WECOM_ACME_SECRET=
WECOM_ACME_TOKEN=
WECOM_ACME_AES_KEY=
